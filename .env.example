# 复制为 .env 后填入真实值；模型名称在 conf/app_config.yaml 里配置
# 聊天模型（查询改写 / 关键词扩展 / 过滤 / SQL 生成都走它，需 OpenAI 兼容 chat 接口）
LLM_API_KEY=
LLM_BASE_URL=https://api.stepfun.com/step_plan/v1

# 向量模型（字段与指标召回用，需 OpenAI 兼容 embeddings 接口）
EMBED_API_KEY=
EMBED_BASE_URL=

# MySQL 密码（meta / dw / biz 三个库共用，docker/mysql 初始化时同步设置）
DB_PASSWORD=
